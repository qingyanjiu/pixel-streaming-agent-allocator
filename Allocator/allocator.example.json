{
  "listenHost": "0.0.0.0",
  "listenPort": 9200,
  "nodeExecutable": "node.exe",
  "apiKey": "replace-with-a-long-random-client-api-key",
  "pollIntervalMs": 2000,
  "workerRequestTimeoutMs": 5000,
  "workerStartTimeoutMs": 210000,
  "workerStopTimeoutMs": 30000,
  "connectTimeoutMs": 600000,
  "idleReleaseMs": 600000,
  "defaultTtlSeconds": 3600,
  "minTtlSeconds": 60,
  "maxTtlSeconds": 86400,
  "autoStart": true,
  "stopOnRelease": true,
  "sessionRetentionMs": 3600000,
  "corsAllowedOrigins": [
    "http://localhost:3000"
  ],
  "workersFile": "./config/workers.json"
}
